{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jasondockery/renovate-config/specs/dependency-coverage.schema.json",
  "type": "object",
  "required": ["schemaVersion", "repository", "surfaces"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "scanSuppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pathPattern", "pattern", "linePattern", "expectedMatches", "reason"],
        "additionalProperties": false,
        "properties": {
          "pathPattern": { "type": "string", "minLength": 1 },
          "pattern": {
            "enum": ["digest", "version-assignment", "release-download", "container-reference", "workflow-reference", "runtime-literal", "plugin-reference"]
          },
          "linePattern": { "type": "string", "minLength": 1 },
          "expectedMatches": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "classification", "manager", "paths", "canonical", "agePolicy", "compensatingControl", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "classification": { "enum": ["built-in", "custom-manager", "derived", "intentional-manual"] },
          "manager": { "type": "string", "minLength": 1 },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "canonical": { "type": "string", "minLength": 1 },
          "agePolicy": {
            "enum": ["renovate-minimum-release-age", "unsupported-by-renovate", "external-tool-policy", "not-applicable"]
          },
          "compensatingControl": { "type": "string", "minLength": 1 },
          "extractionMatchers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["manager", "packageFilePattern", "depNamePattern"],
              "additionalProperties": false,
              "properties": {
                "manager": { "type": "string", "minLength": 1 },
                "packageFilePattern": { "type": "string", "minLength": 1 },
                "depNamePattern": { "type": "string", "minLength": 1 }
              }
            }
          },
          "scanMatchers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["pathPattern", "pattern"],
              "additionalProperties": false,
              "properties": {
                "pathPattern": { "type": "string", "minLength": 1 },
                "pattern": {
                  "enum": ["digest", "version-assignment", "release-download", "container-reference", "workflow-reference", "runtime-literal", "plugin-reference"]
                },
                "linePattern": { "type": "string", "minLength": 1 },
                "optional": { "type": "boolean" }
              }
            }
          },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
